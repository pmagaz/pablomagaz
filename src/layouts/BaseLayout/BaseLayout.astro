---
import { Font } from 'astro:assets';
// import Footer from '~/components/common/Footer/Footer';
import Header from '~/components/common/Header/Header';
import MobileMenu from '~/components/common/MobileMenu/MobileMenu';
import { site } from '~/data/site';
import { personSchema, resolveSeo, type SeoInput } from '~/lib/seo';
import '~/styles/tokens.css';
import '~/styles/global.css';
import '~/styles/reveal.css';
import './BaseLayout.css';

interface Props extends SeoInput {
  /** Extra JSON-LD emitted alongside the Person schema (e.g. BlogPosting). */
  schema?: string;
}

const { schema, ...seoInput } = Astro.props;
const seo = resolveSeo(seoInput, Astro.url, Astro.site);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords && <meta name="keywords" content={seo.keywords} />}
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    {seo.publishedAt && <meta property="article:published_time" content={seo.publishedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />

    <Font cssVariable="--font-outfit" preload />

    {/* Set before first paint so revealed content never flashes.
        The timer is a failsafe that unhides everything if the reveal module
        never loads; reveal.ts clears it as soon as it is running. */}
    <script is:inline>
      document.documentElement.classList.add('pm-js');
      window.__pmRevealFailsafe = setTimeout(function () {
        document.documentElement.classList.add('pm-reveal-all');
      }, 2500);
    </script>

    <script type="application/ld+json" is:inline set:html={personSchema(Astro.site)} />
    {schema && <script type="application/ld+json" is:inline set:html={schema} />}

    {
      /* Google Analytics — production only, so local runs stay out of the data */
      import.meta.env.PROD && site.analyticsId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.analyticsId}');`}
          />
        </>
      )
    }
  </head>

  <body>
    <a class="pm-skip-link" href="#main">Skip to content</a>
    <div class="pm-shell">
      <Header pathname={pathname}>
        <MobileMenu pathname={pathname} nav={site.nav} client:load />
      </Header>
      <main class="pm-shell__main" id="main">
        <slot />
      </main>
      {/* Footer is not in the design handoff yet — kept out until it is. */}
      {/* <Footer year={new Date().getFullYear()} /> */}
    </div>

    <script>
      import '~/lib/reveal';
      import '~/components/common/Header/scrollSpy';
      import '~/components/home/ScrollCue/hideOnScroll';
    </script>
  </body>
</html>
