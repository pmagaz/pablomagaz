---
import LabIndex from '~/components/lab/LabIndex/LabIndex';
import { experiments } from '~/data/experiments';
import BaseLayout from '~/layouts/BaseLayout/BaseLayout.astro';

// Newest first. ISO dates sort correctly as plain strings.
const newestFirst = [...experiments].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Lab"
  description="Interactive generative experiments — fluid simulation, fractals and flow fields, each with its parameters exposed."
>
  <LabIndex experiments={newestFirst} />
</BaseLayout>
