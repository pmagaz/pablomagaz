---
import type { GetStaticPaths } from 'astro';
import BlogList from '~/components/blog/BlogList/BlogList';
import { categoryLabel } from '~/data/categories';
import BaseLayout from '~/layouts/BaseLayout/BaseLayout.astro';
import { buildBlogPage, extraPageNumbers, usedCategories } from '~/lib/blogPage';

export const getStaticPaths = (async () => {
  const used = await usedCategories();

  const paths = await Promise.all(
    used.map(async (category) => {
      const pages = await extraPageNumbers(category);
      return pages.map((page) => ({ params: { category, page: String(page) } }));
    }),
  );

  return paths.flat();
}) satisfies GetStaticPaths;

const { category } = Astro.params;
const page = Number(Astro.params.page);
const listProps = await buildBlogPage(page, category);
const label = categoryLabel(category);
---

<BaseLayout
  title={`${label} — Blog, page ${page}`}
  description={`Posts filed under ${label}.`}
>
  <BlogList {...listProps} />
</BaseLayout>
