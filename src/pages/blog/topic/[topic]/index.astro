---
import type { GetStaticPaths } from 'astro';
import BlogList from '~/components/blog/BlogList/BlogList';
import { topicLabel } from '~/data/topics';
import BaseLayout from '~/layouts/BaseLayout/BaseLayout.astro';
import { buildBlogPage } from '~/lib/blogPage';
import { getSortedPosts } from '~/lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  const used = [...new Set(posts.map((post) => post.data.topic))];
  return used.map((topic) => ({ params: { topic } }));
}) satisfies GetStaticPaths;

const topic = Astro.params.topic;
const listProps = await buildBlogPage(1, topic);
const label = topicLabel(topic);
---

<BaseLayout title={`${label} — Blog`} description={`Posts on ${label.toLowerCase()}.`}>
  <BlogList {...listProps} />
</BaseLayout>
