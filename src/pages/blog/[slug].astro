---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import KeepReading from '~/components/blog/KeepReading/KeepReading';
import PostHeader from '~/components/blog/PostHeader/PostHeader';
import Prose from '~/components/blog/Prose/Prose.astro';
import AuthorStrip from '~/components/common/AuthorStrip/AuthorStrip';
import portraitSource from '~/assets/images/pablo-hero.png';
import BaseLayout from '~/layouts/BaseLayout/BaseLayout.astro';
import { responsiveImage } from '~/lib/images';
import { getSortedPosts, relatedPosts, toSummary, type PostEntry } from '~/lib/posts';
import { articleSchema } from '~/lib/seo';

// One static page per post — every detail page is generated at build time.
export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);

const summary = toSummary(post);
const all = await getSortedPosts();
const related = relatedPosts(all, post).map(toSummary);

const avatar = await responsiveImage(portraitSource, {
  alt: '',
  widths: [88, 132],
});

const schema = articleSchema(
  {
    title: summary.title,
    description: summary.excerpt,
    publishedAt: post.data.date,
    url: new URL(summary.href, Astro.site ?? Astro.url).href,
    author: summary.author,
    keywords: summary.keywords,
  },
  Astro.site,
);
---

<BaseLayout
  title={summary.title}
  description={summary.excerpt}
  keywords={summary.keywords}
  type="article"
  publishedAt={post.data.date}
  schema={schema}
>
  <article>
    <PostHeader post={summary} />

    <Prose>
      <Content />
    </Prose>

    <AuthorStrip avatar={avatar} />
  </article>

  <KeepReading posts={related} />
</BaseLayout>
